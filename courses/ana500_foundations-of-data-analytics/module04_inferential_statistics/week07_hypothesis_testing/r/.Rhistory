library(ggplot2)
file_path <- file.path(
"../datasets/earnings and screen time.xlsx"
)
data <- read_excel(file_path)
# Check the variable names, data types, and first rows
str(data)
head(data)
summary(data)
# Convert kids to a labeled factor for clearer output and plots
data$kids <- factor(
data$kids,
levels = c(0, 1),
labels = c("Without children", "With children")
)
# Use a significance level of 0.05
alpha <- 0.05
# Calculate descriptive statistics for each group
earnings_summary <- aggregate(
earnings ~ kids,
data = data,
FUN = function(x) c(
n = length(!isna(x)),
mean = mean(x),
sd = sd(x)
)
)
print(earnings_summary)
# Calculate descriptive statistics for each group
earnings_summary <- aggregate(
earnings ~ kids,
data = data,
FUN = function(x) c(
n = length(!is.na(x)),
mean = mean(x),
sd = sd(x)
)
)
print(earnings_summary)
# Welch's t-test does not assume equal population variances
earnings_test <- t.test(
data$earnings[data$kids == "Without children"],
data$earnings[data$kids == "With children"],
alternative = "two.sided",
var.equal = FALSE,
conf.level = 0.95
)
print(earnings_test)
# Extract the t-statistic, degrees of freedom, and p-value
t_earnings <- unname(earnings_test$statistic)
df_earnings <- unname(earnings_test$parameter)
p_earnings <- earnings_test$p.value
# The estimates now follow the order of the two input vectors
mean_without <- unname(earnings_test$estimate[1])
mean_with <- unname(earnings_test$estimate[2])
# without children minus with children
mean_difference <- mean_without - mean_with
# Effect size required by the assignment
r_earnings <- sqrt(
t_earnings^2 / (t_earnings^2 + df_earnings)
)
cat("\nEarnings results\n")
cat("Mean difference (without children - with children):", mean_difference, "\n")
cat("t =", t_earnings, "\n")
cat("df =", df_earnings, "\n")
cat("p-value =", p_earnings, "\n")
cat("Effect size r =", r_earnings, "\n")
if (p_earnings < alpha) {
cat("Conclusion: Reject the null hypothesis.\n")
} else {
cat("Conclusion: Fail to reject the null hypothesis.\n")
}
# Calculate each person's difference: screen minus no screen
data$sleep_difference <- data$sleep_screen - data$sleep_noscreen
# Summarize the paired differences
cat("\nPaired sleep difference summary\n")
cat("Number of pairs:", sum(!is.na(data$sleep_difference)), "\n")
cat("Mean difference:", mean(data$sleep_difference, na.rm = TRUE), "\n")
cat("SD of differences:", sd(data$sleep_difference, na.rm = TRUE), "\n")
sleep_test <- t.test(
data$sleep_screen,
data$sleep_noscreen,
paired = TRUE,
alternative = "two.sided",
conf.level = 0.95
)
print(sleep_test)
# Extract test statistics and calculate the assignment effect size
t_sleep <- unname(sleep_test$statistic)
df_sleep <- unname(sleep_test$parameter)
p_sleep <- sleep_test$p.value
r_sleep <- sqrt(
t_sleep^2 / (t_sleep^2 + df_sleep)
)
cat("\nSleep results\n")
cat("Mean difference (screen - no screen):",
mean(data$sleep_difference, na.rm = TRUE), "minutes\n")
cat("t =", t_sleep, "\n")
cat("df =", df_sleep, "\n")
cat("p-value =", p_sleep, "\n")
cat("Effect size r =", r_sleep, "\n")
if (p_sleep < alpha) {
cat("Conclusion: Reject the null hypothesis.\n")
} else {
cat("Conclusion: Fail to reject the null hypothesis.\n")
}
earnings_plot <- ggplot(
data,
aes(x = kids, y = earnings, fill = kids)
) +
geom_boxplot(alpha = 0.7) +
labs(
title = "Annual Earnings by Children Status",
x = "Children status",
y = "Annual earnings (thousands of dollars)"
) +
theme_minimal() +
theme(legend.position = "none")
print(earnings_plot)
# Reshape the two sleep columns into a long format for plotting
sleep_long <- data.frame(
condition = rep(c("Screen", "No screen"), each = nrow(data)),
sleep = c(data$sleep_screen, data$sleep_noscreen)
)
sleep_plot <- ggplot(
sleep_long,
aes(x = condition, y = sleep, fill = condition)
) +
geom_boxplot(alpha = 0.7) +
labs(
title = "Sleep Duration: Screen vs. No-Screen Condition",
x = "Condition",
y = "Sleep duration (minutes)"
) +
theme_minimal() +
theme(legend.position = "none")
print(sleep_plot)
# Reshape the two sleep columns into a long format for plotting
sleep_data <- data[
complete.cases(data[, c("sleep_screen", "sleep_noscreen")]),
]
sleep_long <- data.frame(
condition = rep(c("Screen", "No screen"), each = nrow(sleep_data)),
sleep = c(sleep_data$sleep_screen, sleep_data$sleep_noscreen)
)
