cat("\nMPG mean:", mpg_mean, "\n")
cat("MPG sd:", mpg_sd, "\n")
# Shapiro-Wilk test for normality of mpg
shapiro.test(mtcars$mpg)
# QQ plot for mpg
qqnorm(mtcars$mpg, main = "QQ Plot of MPG")
qqline(mtcars$mpg, col = "red")
