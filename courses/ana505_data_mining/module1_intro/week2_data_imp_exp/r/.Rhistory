# Find the input CSV whether R is running from the project root
# or from the folder containing this script and notebook.
data_candidates <- c(
file.path(
"courses", "ana505_data_mining", "module1_intro",
"week2_data_imp_exp", "datasets", "employee_data_week2.csv"
),
file.path("..", "datasets", "employee_data_week2.csv")
)
existing_paths <- data_candidates[file.exists(data_candidates)]
if (length(existing_paths) == 0) {
stop(
"Could not find employee_data_week2.csv. ",
"Run this script from the project root or the python folder."
)
}
data_path <- existing_paths[1]
output_path <- file.path(dirname(data_path), "employee_data_modified.csv")
# Import the data and inspect its contents and structure.
employee_data <- read.csv(data_path, stringsAsFactors = FALSE)
cat("First six rows:\n")
print(head(employee_data))
cat("\nDataset structure:\n")
str(employee_data)
cat("\nSummary of all columns:\n")
print(summary(employee_data))
# Confirm that the columns needed for this activity are present.
required_columns <- c("Salary", "Experience", "Department")
missing_columns <- setdiff(required_columns, names(employee_data))
if (length(missing_columns) > 0) {
stop(
"Required column(s) missing: ",
paste(missing_columns, collapse = ", ")
)
}
if (!is.numeric(employee_data$Salary) ||
!is.numeric(employee_data$Experience)) {
stop("Salary and Experience must both be numeric columns.")
}
# Calculate requested statistics. R's var() and sd() use sample formulas.
numeric_variables <- list(
Salary = employee_data$Salary,
Experience = employee_data$Experience
)
summary_stats <- as.data.frame(
t(vapply(numeric_variables, function(values) {
values <- values[is.finite(values)]
if (length(values) == 0) {
return(rep(NA_real_, 7))
}
c(
Mean = mean(values),
Median = median(values),
Variance = var(values),
SD = sd(values),
Minimum = min(values),
Maximum = max(values),
Range = diff(range(values))
)
}, numeric(7)))
)
summary_stats$Variable <- rownames(summary_stats)
c(
Mean = mean(values),
Median = median(values),
Variance = var(values),
SD = sd(values),
Minimum = min(values),
Maximum = max(values),
Range = diff(range(values))
)
summary_stats <- as.data.frame(
t(vapply(numeric_variables, function(values) {
values <- values[is.finite(values)]
if (length(values) == 0) {
return(rep(NA_real_, 7))
}
c(
Mean = mean(values),
Median = median(values),
Variance = var(values),
SD = sd(values),
Minimum = min(values),
Maximum = max(values),
Range = diff(range(values))
)
}, numeric(7)))
)
summary_stats$Variable <- rownames(summary_stats)
rownames(summary_stats) <- NULL
summary_stats <- summary_stats[
c("Variable", "Mean", "Median", "Variance", "SD",
"Minimum", "Maximum", "Range")
]
cat("\nSalary and Experience statistics:\n")
print(summary_stats, row.names = FALSE, digits = 2)
# Plot a histogram of salary with mean and median reference lines.
salary_values <- employee_data$Salary[is.finite(employee_data$Salary)]
if (length(salary_values) == 0) {
stop("There are no valid Salary values to plot.")
}
mean_salary <- mean(salary_values)
median_salary <- median(salary_values)
hist(
salary_values,
breaks = 15,
main = "Distribution of Employee Salary",
xlab = "Salary ($)",
ylab = "Number of Employees",
col = "lightblue",
border = "white"
)
abline(v = median_salary, col = "blue", lwd = 2, lty = 2)
legend(
"topright",
legend = c(
paste("Mean: $", format(round(mean_salary, 2), big.mark = ",")),
paste("Median: $", format(round(median_salary, 2), big.mark = ","))
),
col = c("red", "blue"),
lty = c(1, 2),
lwd = 2,
bty = "n"
)
# Keep only complete, finite values for the scatterplots and regression lines.
plot_data <- employee_data[
is.finite(employee_data$Salary) &
is.finite(employee_data$Experience) &
!is.na(employee_data$Department),
]
if (nrow(plot_data) < 2) {
stop("At least two complete rows are needed for the scatterplot.")
}
# Scatterplot with a separate fitted regression line for each department.
department_names <- sort(unique(plot_data$Department))
department_colors <- setNames(
grDevices::hcl.colors(length(department_names), palette = "Dark 3"),
department_names
)
plot(
Experience ~ Salary,
data = plot_data,
pch = 19,
col = department_colors[plot_data$Department],
main = "Salary vs. Experience by Department",
xlab = "Salary ($)",
ylab = "Experience (years)"
)
for (department in department_names) {
department_data <- plot_data[
plot_data$Department == department,
]
if (nrow(department_data) >= 2 &&
length(unique(department_data$Salary)) >= 2) {
department_model <- lm(
Experience ~ Salary,
data = department_data
)
abline(
department_model,
col = department_colors[department],
lwd = 2
)
}
}
abline(
department_model,
col = department_colors[department],
lwd = 2
)
if (nrow(department_data) >= 2 &&
length(unique(department_data$Salary)) >= 2) {
department_model <- lm(
Experience ~ Salary,
data = department_data
)
abline(
department_model,
col = department_colors[department],
lwd = 2
)
}
for (department in department_names) {
department_data <- plot_data[
plot_data$Department == department,
]
if (nrow(department_data) >= 2 &&
length(unique(department_data$Salary)) >= 2) {
department_model <- lm(
Experience ~ Salary,
data = department_data
)
abline(
department_model,
col = department_colors[department],
lwd = 2
)
}
}
legend(
"topleft",
legend = department_names,
col = department_colors[department_names],
pch = 19,
lty = 1,
lwd = 2,
cex = 0.8,
bty = "n"
)
# Filter to Engineering and plot its fitted regression line.
engineering_data <- plot_data[
plot_data$Department == "Engineering",
]
if (nrow(engineering_data) < 2 ||
length(unique(engineering_data$Salary)) < 2) {
stop("Not enough Engineering rows to fit a regression line.")
}
engineering_model <- lm(
Experience ~ Salary,
data = engineering_data
)
plot(
Experience ~ Salary,
data = engineering_data,
pch = 19,
col = "steelblue",
main = "Salary vs. Experience - Engineering",
xlab = "Salary ($)",
ylab = "Experience (years)"
)
abline(engineering_model, col = "red", lwd = 2)
# Create Low, Medium, and High salary groups using three quantile groups.
# This matches the Python qcut(..., q = 3) approach.
salary_cutoffs <- quantile(
employee_data$Salary,
probs = c(1 / 3, 2 / 3),
na.rm = TRUE,
names = FALSE
)
if (length(unique(c(min(employee_data$Salary, na.rm = TRUE),
salary_cutoffs,
max(employee_data$Salary, na.rm = TRUE)))) < 3) {
stop("Salary values do not have enough distinct quantile cutoffs.")
}
employee_data$Salary_Category <- cut(
employee_data$Salary,
breaks = c(-Inf, salary_cutoffs, Inf),
labels = c("Low", "Medium", "High"),
include.lowest = TRUE,
ordered_result = TRUE
)
# Export the updated dataset without adding row numbers.
write.csv(employee_data, output_path, row.names = FALSE)
cat("\nUpdated dataset saved to:\n", output_path, "\n")
cat("\nSalary category counts:\n")
print(table(employee_data$Salary_Category, useNA = "ifany"))
# Install required packages if they are not already installed
required_packages <- c("ggplot2", "dplyr")
missing_packages <- required_packages[
!sapply(X = required_packages, FUN = requireNamespace, quietly = TRUE)
]
if (length(missing_packages) > 0) {
install.packages(missing_packages, dependencies = TRUE)
}
library(ggplot2)
library(dplyr)
#==========================================================
## 1. Read the dataset
#==========================================================
fname <- "../datasets/employee_data_week2.csv"
if (!file.exists(fname)) {
stop(
"Dataset not found. Make sure employee_data_week2.csv ",
"is in the ../datasets/ folder."
)
}
employee_data <- read.csv(fname, stringsAsFactors = FALSE)
# Display the first few rows
head(employee_data)
# Display the dataset structure
str(employee_data)
#==========================================================
## 2. Data exploration
#==========================================================
# Summary statistics for all variables
summary(employee_data)
# Summary statistics for Salary and Experience
required_variables <- c("Salary", "Experience")
summary(employee_data[required_variables])
# Calculate requested statistics
stats <- data.frame(
Variable = required_variables,
Mean = sapply(
employee_data[required_variables],
mean,
na.rm = TRUE
),
Median = sapply(
employee_data[required_variables],
median,
na.rm = TRUE
),
Variance = sapply(
employee_data[required_variables],
var,
na.rm = TRUE
),
Standard_Deviation = sapply(
employee_data[required_variables],
sd,
na.rm = TRUE
),
Minimum = sapply(
employee_data[required_variables],
min,
na.rm = TRUE
),
Maximum = sapply(
employee_data[required_variables],
max,
na.rm = TRUE
),
Range = sapply(
employee_data[required_variables],
function(x) diff(range(x, na.rm = TRUE))
)
)
stats
# Check for missing values
colSums(is.na(employee_data))
## 3.1 Histogram: Salary
# Calculate mean and median salary
mean_salary <- mean(employee_data$Salary, na.rm = TRUE)
median_salary <- median(employee_data$Salary, na.rm = TRUE)
# Create salary histogram
ggplot(employee_data, aes(x = Salary)) +
geom_histogram(
bins = 15,
color = "white",
fill = "steelblue"
) +
geom_vline(
xintercept = mean_salary,
color = "red",
linetype = "solid"
) +
geom_vline(
xintercept = median_salary,
color = "blue",
linetype = "dashed"
) +
labs(
title = "Distribution of Employee Salary",
x = "Employee Salary",
y = "Number of Employees"
) +
theme_minimal()
## 3.2 Scatterplot: Salary and Experience by department
ggplot(
employee_data,
aes(x = Salary, y = Experience, color = Department)
) +
geom_point() +
geom_smooth(
method = "lm",
se = FALSE
) +
labs(
title = "Salary vs. Experience by Department",
x = "Employee Salary",
y = "Experience in Years",
color = "Department"
) +
theme_minimal()
## 3.3 Scatterplot: Salary and Experience by education level
ggplot(
employee_data,
aes(x = Salary, y = Experience, color = Education_Level)
) +
geom_point() +
geom_smooth(
method = "lm",
se = FALSE
) +
labs(
title = "Salary vs. Experience by Education Level",
x = "Employee Salary",
y = "Experience in Years",
color = "Education Level"
) +
theme_minimal()
## 3.4 Scatterplot: Engineering employees
engineering_data <- employee_data %>%
filter(Department == "Engineering")
ggplot(
engineering_data,
aes(x = Salary, y = Experience)
) +
geom_point(color = "steelblue") +
geom_smooth(
method = "lm",
se = FALSE,
color = "red"
) +
labs(
title = "Salary vs. Experience - Engineering",
x = "Employee Salary",
y = "Experience in Years"
) +
theme_minimal()
#==========================================================
## 4. Data export
#==========================================================
# Create three salary categories using tertile cutoffs,
# matching the Python qcut(..., q = 3) code.
salary_cutoffs <- quantile(
employee_data$Salary,
probs = c(1 / 3, 2 / 3),
na.rm = TRUE
)
employee_data$Salary_Category <- cut(
employee_data$Salary,
breaks = c(-Inf, salary_cutoffs, Inf),
labels = c("Low", "Medium", "High"),
include.lowest = TRUE
)
# Review the salary categories
table(employee_data$Salary_Category)
# Save the modified dataset
modified_path <- "../datasets/employee_data_week2_modified.csv"
write.csv(
employee_data,
file = modified_path,
row.names = FALSE
)
cat("Modified dataset saved to:", modified_path, "\n")
